<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Wave Header -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="#FFFFFF" />

    <!-- ScrollView konten -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TextInputLayout Search -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cari Data Desa"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ChipGroup Filter -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPertanian"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Pertanian" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPengumuman"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengumuman" />

            </com.google.android.material.chip.ChipGroup>

            <!-- GridLayout Menu -->
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:columnCount="2"
                app:useDefaultMargins="true">

                <!-- Bumdes -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBumdes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Bumdes"
                    android:drawableTop="@android:drawable/ic_menu_agenda"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Profil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Profil"
                    android:drawableTop="@android:drawable/ic_menu_myplaces"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Forum -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Forum"
                    android:drawableTop="@android:drawable/ic_menu_send"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Web Desa -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Web Desa"
                    android:drawableTop="@android:drawable/ic_menu_mapmode"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

            </androidx.gridlayout.widget.GridLayout>

            <!-- Tentang Aplikasi Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTentangAplikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tentang Aplikasi"
                android:layout_marginBottom="8dp"
                app:icon="@android:drawable/ic_menu_info_details"
                app:cornerRadius="8dp" />

            <!-- Keluar Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keluar Aplikasi"
                android:backgroundTint="#C62828"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>