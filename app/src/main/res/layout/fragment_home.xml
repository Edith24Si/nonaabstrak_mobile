<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Wave Header -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="#FFFFFF" />

    <!-- ScrollView konten -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/background_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Image Slider (Banner) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>

            <!-- TextInputLayout Search -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cari Data Desa"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- GridLayout Menu -->
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:columnCount="2"
                app:useDefaultMargins="true">

                <!-- Produk Hukum (Pertemuan 10) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProdukHukum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Produk Hukum"
                    android:drawableTop="@android:drawable/ic_menu_sort_by_size"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Pesan & Informasi (Pertemuan 9) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInformasiDesa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Info Desa"
                    android:drawableTop="@android:drawable/ic_menu_my_calendar"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Layanan Aspirasi (Pertemuan 2) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAspirasi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Aspirasi"
                    android:drawableTop="@android:drawable/ic_menu_edit"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Web Desa (Pertemuan 5) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Web Desa"
                    android:drawableTop="@android:drawable/ic_menu_mapmode"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Tugas Pertemuan 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGaleriDesa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Galeri Desa"
                    android:drawableTop="@android:drawable/ic_menu_gallery"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

                <!-- Tugas Pertemuan 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayananMandiri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Layanan Mandiri"
                    android:drawableTop="@android:drawable/ic_menu_agenda"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="8dp"
                    android:layout_margin="4dp" />

            </androidx.gridlayout.widget.GridLayout>

            <!-- Tentang Aplikasi Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTentangAplikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengaturan &amp; Akun"
                android:layout_marginBottom="8dp"
                app:icon="@android:drawable/ic_menu_manage"
                app:cornerRadius="8dp" />

            <!-- Keluar Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keluar Aplikasi"
                android:backgroundTint="#C62828"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>